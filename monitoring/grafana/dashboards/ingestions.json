          "rawQuery": true,
          "rawSql": "SELECT COALESCE(o.sys_name, '(sem origem)') AS metric, count(i.ingestion_id) AS total FROM ingestions i LEFT JOIN ingestions_table_metadata tm ON tm.ingestion_id = i.ingestion_id AND tm.version = i.active_version LEFT JOIN origins o ON o.sys_id = tm.origin GROUP BY 1 ORDER BY 2 DESC;",
          "datasource": { "type": "postgres", "uid": "data-master-pg" }
