          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Cadastradas\" FROM ingestions;",
          "datasource": { "type": "postgres", "uid": "data-master-pg" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }, { "color": "green", "value": 1 }]
