          "rawQuery": true,
          "rawSql": "SELECT COALESCE(s.name, '(sem sigla)') AS metric, count(i.ingestion_id) AS total FROM ingestions i LEFT JOIN siglas s ON s.sigla_id = i.sigla_id GROUP BY 1 ORDER BY 2 DESC;",
          "datasource": { "type": "postgres", "uid": "data-master-pg" }
