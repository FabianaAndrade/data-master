    {
      "id": 15,
      "type": "table",
      "title": "Últimas ingestões",
      "datasource": { "type": "postgres", "uid": "data-master-pg" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT i.ingestion_id AS \"ID\", i.status AS \"Status\", COALESCE(s.name, '—') AS \"Sigla\", i.created_at::text AS \"Criada em\", COALESCE(tm.table_name, '—') AS \"Tabela\", COALESCE(tm.layer, '—') AS \"Layer\", COALESCE(tm.origin_format, '—') AS \"Formato\", COALESCE(tm.periodicity, '—') AS \"Periodicidade\" FROM ingestions i LEFT JOIN siglas s ON s.sigla_id = i.sigla_id LEFT JOIN ingestions_table_metadata tm ON tm.ingestion_id = i.ingestion_id AND tm.version = i.active_version ORDER BY i.created_at DESC, i.ingestion_id DESC LIMIT 20;",
          "datasource": { "type": "postgres", "uid": "data-master-pg" }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text",
                  "mode": "background",
                  "patterns": [
                    { "displayText": "SUCESSO", "color": "green", "pattern": "SUCCESS" },
                    { "displayText": "ERRO", "color": "red", "pattern": "FAILED" },
                    { "displayText": "PENDENTE", "color": "orange", "pattern": "PENDING_APPROVAL" },
                    { "displayText": "APROVADA", "color": "blue", "pattern": "APPROVED" },
                    { "displayText": "CANCELADA", "color": "purple", "pattern": "CANCELLED" },
                    { "displayText": "EXCLUSAO", "color": "dark-blue", "pattern": "PENDING_DELETE" },
                    { "displayText": "EXCLUIDA", "color": "dark-gray", "pattern": "DELETED" }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "footer": { "countRows": false, "enablePagination": false, "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "Criada em", "desc": true }]
      }
    }
