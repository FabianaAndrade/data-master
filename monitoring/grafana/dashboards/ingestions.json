      "datasource": { "type": "postgres", "uid": "data-master-pg" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT p.pii_name AS metric, count(*) AS total FROM ingestions_columns_metadata c JOIN pii_types p ON p.pii_id = c.pii_id WHERE c.pii_id IS NOT NULL AND c.pii_id != 1 GROUP BY 1 ORDER BY 2 DESC;",
          "datasource": { "type": "postgres", "uid": "data-master-pg" }
